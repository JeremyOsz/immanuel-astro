# Astrology API Environment Variables
# Copy this file to .env and fill in your actual values

# Required: Your secret API key for authentication
# Generate a strong, random key for production use
API_KEY=your-secret-api-key-here

# Optional: Environment setting
ENVIRONMENT=development

# Optional: Server configuration
HOST=0.0.0.0
PORT=8000

# Optional: shared timeline cache (recommended for serverless)
# Example: rediss://default:<password>@<host>:<port>
REDIS_URL=

# Optional: timeline response cache tuning
# Cache TTL in seconds (default: 2592000 / 30 days)
TIMELINE_RESPONSE_CACHE_TTL_SECONDS=2592000
# Increase to force global cache bust after logic/schema changes
TIMELINE_RESPONSE_CACHE_VERSION=v1
# Max in-memory response entries per warm instance
TIMELINE_RESPONSE_CACHE_MAX_ITEMS=500

# Example of a strong API key (generate your own):
# API_KEY=astrology-api-key-2024-xyz789-abc123-def456 
